{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.teamvrotek.caffeinetracker",
  "Name": "Caffeine Tracker",
  "Version": "1.0.0",
  "Author": "VROTEK OÜ",
  "Description": "Track caffeine in your bloodstream with half-life math. Press to log a drink, long-press to undo. Every button shows your current mg and when it's safe to sleep.",
  "Category": "Caffeine Tracker",
  "CategoryIcon": "imgs/categoryIcon",
  "Icon": "imgs/pluginIcon",
  "URL": "https://github.com/teamvrotek/caffeine-tracker",
  "CodePath": "plugin.js",
  "PropertyInspectorPath": "ui/property-inspector.html",
  "SDKVersion": 3,
  "Nodejs": {
    "Version": "20"
  },
  "Software": {
    "MinimumVersion": "6.9"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Icon": "imgs/actionIcon",
      "Name": "Caffeine Drink",
      "States": [
        {
          "Image": "imgs/actionDefaultImage",
          "Title": "",
          "TitleAlignment": "bottom",
          "FontSize": "16",
          "ShowTitle": false
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Log a dose of caffeine. Long-press to undo the most recent dose.",
      "UUID": "com.teamvrotek.caffeinetracker.drink",
      "PropertyInspectorPath": "ui/property-inspector.html"
    }
  ]
}
